@model List<Notification>
@{ViewData["Title"]="Planner & thông báo";var tasks=(List<WorkTask>)ViewBag.Tasks;var prefs=(AppPreferences)ViewBag.Preferences;var health=(WorkerHealth?)ViewBag.Health;}
<div class="page-heading"><div><div class="eyebrow">RULES-BASED · CHỈ CHẠY KHI ỨNG DỤNG MỞ</div><h1>Planner & thông báo</h1><p class="muted">Nhắc theo lịch bền vững; khi mở lại sẽ xử lý lịch đã đến hạn, không giả vờ gửi khi máy tắt.</p></div><a href="/Integrations">Cấu hình giờ nhắc & SMTP</a></div><p>Worker gần nhất: @(health?.LastRunAtUtc is {} date?WorkRules.LocalTime(date):"Chưa chạy / đang tắt") · @health?.LastErrorCode</p><div class="grid"><section class="card"><h2>Lên lịch theo dõi</h2><form method="post" asp-action="Schedule"><label>Công việc<select name="taskId">@foreach(var t in tasks){<option value="@t.Id">@t.Title</option>}</select></label><label>Thời điểm (giờ Việt Nam)<input type="datetime-local" name="scheduledLocal" required/></label><button class="button">Lưu lịch nhắc trong ứng dụng</button></form><h3>Việc đang mở</h3>@foreach(var t in tasks.Take(12)){<a class="list-link" href="/Tasks/Details/@t.Id"><span>@t.Title<small>@WorkRules.Label(t.Status) · @(t.WaitingFor??t.Blocker??t.NextAction)</small></span><span>@WorkRules.Date(t.DueDate)<small>@WorkRules.Label(t.DueDateType)</small></span></a>}</section><section class="card"><h2>Lịch đã lưu</h2>@foreach(Reminder r in ViewBag.Reminders){<div class="activity"><b>@WorkRules.LocalTime(r.ScheduledAtUtc) · @r.Status</b><small>@(tasks.FirstOrDefault(t=>t.Id==r.TaskId)?.Title??r.TaskId.ToString())</small>@if(r.Status=="Pending"){<form method="post" asp-action="Cancel" asp-route-id="@r.Id"><input type="hidden" name="version" value="@r.Version"/><button>Hủy lịch nhắc</button></form>}</div>}</section></div><section class="card"><h2>Trung tâm thông báo · @Model.Count(n=>n.ReadAtUtc==null) chưa đọc</h2>@foreach(var n in Model){<article class="message"><h3>@n.Title · @(n.ReadAtUtc==null?"Chưa đọc":"Đã đọc")</h3><p class="preserve">@n.Body</p><small>@WorkRules.LocalTime(n.CreatedAtUtc)</small><form method="post" asp-action="Read" asp-route-id="@n.Id"><input type="hidden" name="version" value="@n.Version"/><button>Đã đọc</button><button name="dismiss" value="true">Bỏ qua</button></form>@if(n.TaskId!=null){<a href="/Tasks/Details/@n.TaskId">Mở công việc</a><form method="post" asp-action="Snooze" asp-route-id="@n.Id"><input type="hidden" name="version" value="@n.Version"/><label>Hoãn đến (giờ Việt Nam)<input type="datetime-local" name="untilLocal" required/></label><button>Hoãn & không hỏi lại trước thời điểm này</button></form>}@if(prefs.SmtpEnabled){<details><summary>Gửi thông báo này qua SMTP — cần xác nhận người nhận</summary><form method="post" asp-action="SendEmail" asp-route-id="@n.Id"><p>Người nhận đã cấu hình: @prefs.SmtpRecipient</p><label>Nhập lại chính xác email người nhận<input type="email" name="confirmRecipient" required/></label><button>Tôi đồng ý gửi nội dung này</button></form></details>}</article>}@if(Model.Count==0){<p class="empty">Chưa có thông báo. Tạo lịch nhắc hoặc chờ giờ briefing khi có việc cần hỏi.</p>}</section><section class="card"><h2>Kiểm tra SMTP theo yêu cầu</h2><p>Chỉ gửi nội dung test không chứa dữ liệu công ty. SMTP @((prefs.SmtpEnabled)?"đã bật":"đang tắt"). Recipient: @prefs.SmtpRecipient</p><form method="post" asp-action="SendEmail"><input type="hidden" name="test" value="true"/><label>Xác nhận chính xác người nhận<input type="email" name="confirmRecipient" required/></label><button>Tôi xác nhận gửi email kiểm thử</button></form><p class="muted">Chưa rõ trạng thái SMTP được đánh dấu Unknown và không tự gửi lại để tránh trùng.</p></section>
