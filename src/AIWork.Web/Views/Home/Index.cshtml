@{ViewData["Title"]="Dashboard";}
<div id="dashboard" data-endpoint="/Dashboard/Data"><div class="page-heading"><div><div class="eyebrow">YOUR WORK, IN FOCUS</div><h1>Dashboard công việc</h1><p class="muted">Một góc nhìn cho tiến độ, kế hoạch và những việc cần bạn quyết định.</p></div><div class="heading-actions"><a class="button secondary" href="/Analysis">↥ Phân tích file</a><a class="button" href="/Chat">✦ Hỏi trợ lý</a></div></div><form id="dashboard-filters" class="filters"><label>Luồng công việc<select name="workstreamId" id="filter-workstream"><option value="">Tất cả luồng</option></select></label><label>Trạng thái<select name="status" asp-items="Ui.Options<ProjectStatus>()"><option value="">Tất cả trạng thái</option></select></label><label>Hạn từ<input name="from" type="date"/></label><label>Đến<input name="until" type="date"/></label><button class="button">Áp dụng</button><button type="reset">Đặt lại</button></form><div id="dashboard-state" class="notice" role="status">Đang tải dữ liệu SQLite…</div><div id="kpi-grid" class="stats kpi-eight"></div><div class="dashboard-charts"><section id="project-progress" class="card"><div class="section-heading"><h2>Tiến độ dự án</h2><span class="badge">Thực tế · Kế hoạch</span></div><div id="progress-chart" class="chart-region"></div><p class="muted small-note">Thực tế = số việc Done / việc chưa hủy. Kế hoạch chỉ có khi mọi việc có hạn Planned/Committed; thiếu cơ sở hiển thị “Chưa đủ dữ liệu”.</p></section><section class="card"><h2>Sức khỏe danh mục</h2><div id="health-chart" class="chart-region"></div><div id="health-legend"></div><p class="muted small-note">“Chưa xác minh” giữ riêng; không tự quy thành đúng kế hoạch.</p></section></div><section id="timeline" class="card"><div class="section-heading"><h2>Timeline & mốc công việc</h2><span class="badge">Không suy đoán ngày bắt đầu</span></div><div id="timeline-view" class="timeline-region"></div><div id="dependency-summary" class="muted"></div></section><section class="card"><div class="section-heading"><h2>Công việc cần theo dõi</h2><a href="/Tasks/Edit">+ Tạo công việc</a></div><div class="filters"><input id="grid-search" aria-label="Tìm trong bảng" placeholder="Tìm trong tên việc / người phụ trách…"/><label>Nhóm theo<select id="grid-group"><option value="">Không nhóm</option><option value="project">Dự án</option><option value="status">Trạng thái</option><option value="priority">Ưu tiên</option></select></label><label>Sắp xếp<select id="grid-sort"><option value="dueDate">Ngày hạn</option><option value="priority">Ưu tiên</option><option value="title">Tên công việc</option></select></label></div><div id="task-grid" class="table-wrap"></div><div id="grid-pagination" class="pagination"></div></section><div class="grid"><section class="card"><h2>Work Briefing (rules-based)</h2><div id="dashboard-insights"></div><a href="/Chat">Yêu cầu AI diễn giải bằng dữ liệu được phép</a></section><section class="card"><h2>Thay đổi gần đây</h2><div id="dashboard-recent"></div></section></div><form class="antiforgery-only" method="post">@Html.AntiForgeryToken()</form></div>
@section Scripts{<script src="~/js/dashboard.js" asp-append-version="true" defer></script>}
