@model List<WorkTask>
@{ViewData["Title"]="Trợ lý công việc";var today=WorkRules.Today;var open=Model.Where(t=>t.Status is not (WorkStatus.Done or WorkStatus.Cancelled)).ToList();var overdue=open.Where(t=>t.IsOverdue(today)).ToList();var priorities=open.Where(t=>t.NextCheckAtUtc==null||t.NextCheckAtUtc<=DateTime.UtcNow).OrderByDescending(t=>t.Status==WorkStatus.Blocked).ThenByDescending(t=>t.IsOverdue(today)).ThenByDescending(t=>t.Priority).ThenBy(t=>t.DueDate??DateOnly.MaxValue).Take(5).ToList();}
<div class="page-heading"><div><div class="eyebrow">KHÔNG GIAN LÀM VIỆC · @today.ToString("dd/MM/yyyy")</div><h1>Trợ lý công việc</h1><p class="muted">Nắm rõ ưu tiên. Theo sát tiến độ. Chủ động bước tiếp theo.</p></div><a class="button secondary" href="/Inbox/Capture">+ Ghi nhanh vào Inbox</a><a class="button" href="/Tasks/Edit">+ Thêm công việc</a></div>
<section class="card"><div class="eyebrow">AI WORKSPACE · DỮ LIỆU CỤC BỘ LÀ NGUỒN SỰ THẬT</div><form method="post" asp-controller="Chat" asp-action="Ask"><label for="home-question">Bạn cần trợ lý hỗ trợ điều gì?</label><textarea id="home-question" name="text" rows="3" maxlength="6000" required placeholder="Ví dụ: Hôm nay tôi cần theo dõi những công việc nào?"></textarea><button class="button">Hỏi trợ lý</button> <a href="/Integrations">Cấu hình AI & quyền gửi dữ liệu</a></form><small>Không có cấu hình/quyền dữ liệu: lưu câu hỏi và báo AI chưa khả dụng. Không giả lập phản hồi.</small></section><section class="briefing"><div class="eyebrow">WORK BRIEFING (RULES-BASED)</div><h2>Ưu tiên hôm nay</h2><p>Tổng hợp theo quy tắc từ dữ liệu đã lưu; chưa sử dụng OpenAI.</p>@if(priorities.Count==0){<div class="empty">Không có công việc đang mở. <a href="/Import">Nhập workbook 9 dự án</a> hoặc tạo công việc đầu tiên.</div>}@foreach(var t in priorities){<a class="brief-row" href="/Tasks/Details/@t.Id"><span>@t.Title<small>@(t.NextAction??"Chưa ghi bước tiếp theo")</small></span><span class="badge">@WorkRules.Label(t.Status) · @WorkRules.Date(t.DueDate) · @WorkRules.Label(t.DueDateType)</span></a>}<div class="planned"><a href="/Chat">Mở AI Workspace</a> · Cần bật cấu hình & quyền dữ liệu</div></section>
<div class="stats"><a href="/Projects"><span>Dự án</span><strong>@ViewBag.Projects</strong><small>Trong danh mục hiện tại</small></a><a href="/Tasks"><span>Công việc đang mở</span><strong>@open.Count</strong><small>@Model.Count(t=>t.Status==WorkStatus.Done) việc hoàn thành</small></a><a href="/Tasks?due=overdue"><span>Quá hạn</span><strong class="danger">@overdue.Count</strong><small>@overdue.Count(t=>t.DueDateType==DeadlineType.Committed) cam kết · @overdue.Count(t=>t.DueDateType==DeadlineType.Planned) kế hoạch · @overdue.Count(t=>t.DueDateType==DeadlineType.Suggested) gợi ý</small></a><a href="/Tasks?status=Blocked"><span>Vướng mắc</span><strong>@open.Count(t=>t.Status==WorkStatus.Blocked)</strong><small>Cần bước xử lý cụ thể</small></a></div>
<div class="stats"><a href="/Inbox?status=NeedsReview"><span>Inbox cần rà soát</span><strong>@ViewBag.InboxCount</strong></a><a href="/Actions"><span>Đề xuất chờ duyệt</span><strong>@ViewBag.PendingActions</strong></a><a href="/Tracking?kind=Issue"><span>Vấn đề chưa xác minh</span><strong>@ViewBag.OpenIssues</strong></a><a href="/Tracking?kind=Decision"><span>Quyết định cần xử lý</span><strong>@ViewBag.Decisions</strong></a></div><div class="grid"><section class="card"><h2>Theo dõi trong ngày</h2><a class="list-link" href="/Tasks?due=today">Đến hạn hôm nay <b>@open.Count(t=>t.DueDate==today)</b></a><a class="list-link" href="/Tasks?due=week">Đến hạn 7 ngày tới <b>@open.Count(t=>t.DueDate>=today&&t.DueDate<=today.AddDays(7))</b></a><a class="list-link" href="/Tasks?status=Waiting">Chờ xác nhận <b>@open.Count(t=>t.Status==WorkStatus.Waiting)</b></a><a class="list-link" href="/Tasks?due=review">Thiếu PIC hoặc ngày hạn <b>@Model.Count(t=>string.IsNullOrWhiteSpace(t.OwnerText)||t.DueDate==null)</b></a><a class="list-link" href="/Tasks?sort=priority">Ưu tiên cao / khẩn cấp <b>@open.Count(t=>t.Priority>=Priority.High)</b></a></section><section class="card"><h2>Hoạt động gần đây</h2>@foreach(AuditEvent a in ViewBag.History){<div class="activity"><b>@a.Action · @a.EntityType</b><small>@a.Actor · @WorkRules.LocalTime(a.OccurredAtUtc)</small></div>}</section></div>





