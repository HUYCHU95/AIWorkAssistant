@model AIWork.Web.Controllers.Credentials
@{ViewData["Title"]="Tạo tài khoản đầu tiên";}
<section class="auth card"><div class="eyebrow">CHÀO MỪNG ĐẾN AIWORK</div><h1>Tạo tài khoản cá nhân</h1><p>Dữ liệu chỉ lưu trong thư mục ứng dụng trên máy này. Không có mật khẩu mặc định.</p><form asp-action="Setup" method="post"><div asp-validation-summary="All" class="validation"></div><label asp-for="UserName">Tên đăng nhập</label><input asp-for="UserName" autocomplete="username" required/><label asp-for="Password">Mật khẩu (12–128 ký tự)</label><input asp-for="Password" autocomplete="new-password" required/><button class="button">Tạo tài khoản & bắt đầu</button></form><p class="muted">Ghi nhớ mật khẩu; V0.1 chưa có chức năng lấy lại mật khẩu.</p></section>
