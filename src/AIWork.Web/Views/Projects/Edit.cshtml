@model Project
@{ViewData["Title"]="Thông tin dự án";}
<div class="page-heading"><h1>Thông tin dự án</h1><a href="/Projects">← Danh sách</a></div>
<partial name="_AIEntry"/>
<form class="card editor" asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><div asp-validation-summary="All" class="validation"></div><div class="grid"><div><label asp-for="Code">Mã dự án *</label><input asp-for="Code" required maxlength="40"/></div><div><label asp-for="Name">Tên dự án *</label><input asp-for="Name" required maxlength="300"/></div><div><label asp-for="WorkstreamId">Luồng công việc</label><select asp-for="WorkstreamId"><option value="">Không có</option>@foreach(Workstream w in ViewBag.Workstreams){<option value="@w.Id">@w.Name @(w.ArchivedAtUtc != null ? "· Đã lưu trữ" : "")</option>}</select></div><div><label asp-for="OwnerText">Người phụ trách đã xác nhận</label><input asp-for="OwnerText" maxlength="200"/></div><div><label asp-for="Phase">Giai đoạn</label><select asp-for="Phase" asp-items="Ui.Options<ProjectPhase>()"></select></div><div><label asp-for="Status">Trạng thái</label><select asp-for="Status" asp-items="Ui.Options<ProjectStatus>()"></select></div><div><label asp-for="Health">Sức khỏe</label><select asp-for="Health" asp-items="Ui.Options<Health>()"></select></div><div><label asp-for="BaselineTargetDate">Mốc kế hoạch ban đầu</label><input asp-for="BaselineTargetDate" type="date"/></div><div><label asp-for="CurrentTargetDate">Mốc mục tiêu hiện tại</label><input asp-for="CurrentTargetDate" type="date"/></div><div><label asp-for="ActualApplyDate">Ngày áp dụng thực tế</label><input asp-for="ActualApplyDate" type="date"/></div></div><label asp-for="Objective">Mục tiêu</label><textarea asp-for="Objective" rows="3"></textarea><label asp-for="Scope">Phạm vi</label><textarea asp-for="Scope" rows="3"></textarea><label asp-for="StatusReason">Rủi ro / lý do trạng thái</label><textarea asp-for="StatusReason" rows="3"></textarea><button class="button">Lưu dự án</button></form>
