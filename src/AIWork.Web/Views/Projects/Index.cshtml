@model List<Project>
@{ViewData["Title"]="Danh mục dự án";var allTasks=(List<WorkTask>)ViewBag.AllTasks;}
<div class="page-heading"><div><div class="eyebrow">PORTFOLIO · @Model.Count DỰ ÁN</div><h1>Danh mục dự án</h1><p class="muted">Theo dõi kế hoạch, tiến độ thực tế và các điểm cần xử lý.</p></div><a class="button" href="/Projects/Edit">+ Tạo dự án</a></div>
<form class="filters" method="get"><input name="q" value="@Context.Request.Query["q"]" placeholder="Tên, mã, từ khóa…"/><select aria-label="Trạng thái" name="status"><option value="">Mọi trạng thái</option>@foreach(var s in Enum.GetValues<ProjectStatus>()){<option value="@s" selected="@(Context.Request.Query["status"]==s.ToString())">@WorkRules.Label(s)</option>}</select><select aria-label="Giai đoạn" name="phase"><option value="">Mọi giai đoạn</option>@foreach(var s in Enum.GetValues<ProjectPhase>()){<option value="@s" selected="@(Context.Request.Query["phase"]==s.ToString())">@WorkRules.Label(s)</option>}</select><input name="owner" value="@Context.Request.Query["owner"]" placeholder="Người phụ trách"/><label><input type="checkbox" name="archived" value="true" checked="@(Context.Request.Query["archived"]=="true")"/> Gồm lưu trữ</label><button>Lọc</button><a href="/Projects">Đặt lại</a></form>
<div class="card table-wrap"><table><thead><tr><th>Dự án</th><th>Phụ trách</th><th>Giai đoạn / trạng thái</th><th>Mục tiêu hiện tại</th><th>Tiến độ</th><th>Sức khỏe</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><small>@p.Code @(p.ArchivedAtUtc!=null?"· Đã lưu trữ":"")</small><a href="/Projects/Details/@p.Id">@p.Name</a></td><td>@(p.OwnerText??"Chưa xác nhận")</td><td>@WorkRules.Label(p.Phase)<small>@WorkRules.Label(p.Status)</small></td><td>@WorkRules.Date(p.CurrentTargetDate)</td><td>@WorkRules.Progress(allTasks.Where(t=>t.ProjectId==p.Id))</td><td><span class="badge">@WorkRules.Label(p.Health)</span></td></tr>}</tbody></table>@if(Model.Count==0){<div class="empty">Chưa có dự án phù hợp. <a href="/Import">Nhập workbook mẫu</a> hoặc tạo dự án.</div>}</div>
