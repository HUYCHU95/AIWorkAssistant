@model Project
@{ViewData["Title"]=Model.Name;var tasks=(List<WorkTask>)ViewBag.Tasks;var workstreams=(List<Workstream>)ViewBag.Workstreams;}
<div class="page-heading"><div><div class="eyebrow">@Model.Code · @WorkRules.Label(Model.Status) @(Model.ArchivedAtUtc!=null?"· Đã lưu trữ":"")</div><h1>@Model.Name</h1><p class="muted">@WorkRules.Label(Model.Phase) · @WorkRules.Label(Model.Health)</p></div><a class="button" href="/Projects/Edit/@Model.Id">Chỉnh sửa dự án</a></div>
<div class="grid"><section class="card"><h2>Tổng quan</h2><dl><dt>Người phụ trách</dt><dd>@(Model.OwnerText??"Chưa xác nhận")</dd><dt>Luồng công việc</dt><dd>@(workstreams.FirstOrDefault(w=>w.Id==Model.WorkstreamId)?.Name??"Không có / đã lưu trữ")</dd><dt>Mốc kế hoạch ban đầu</dt><dd>@WorkRules.Date(Model.BaselineTargetDate)</dd><dt>Mốc mục tiêu hiện tại</dt><dd>@WorkRules.Date(Model.CurrentTargetDate)</dd><dt>Ngày áp dụng thực tế</dt><dd>@WorkRules.Date(Model.ActualApplyDate)</dd><dt>Tiến độ công việc</dt><dd>@WorkRules.Progress(tasks) · Không tính công việc đã hủy</dd></dl></section><section class="card"><h2>Mục tiêu & phạm vi</h2><p class="preserve">@Model.Objective</p><p class="preserve">@Model.Scope</p><h3>Rủi ro / trạng thái</h3><p class="preserve">@Model.StatusReason</p><details><summary>Thông tin nguồn nhập</summary><p class="preserve">@(Model.SourceLabel??"Tạo thủ công")</p></details></section></div>
<div class="tabs"><a href="/Chat?projectId=@Model.Id">Hỏi AI với ngữ cảnh dự án</a><a href="/Sources">Nguồn & tài liệu</a><a href="/Tracking?projectId=@Model.Id">Vấn đề / cam kết / chỉ thị / quyết định</a><a href="/Tracking/Edit?projectId=@Model.Id">+ Hồ sơ liên quan</a></div><section class="card"><div class="page-heading"><h2>Công việc trong dự án</h2><a class="button" href="/Tasks/Edit?projectId=@Model.Id">+ Thêm công việc</a></div>@if(tasks.Count==0){<p class="empty">Chưa có công việc.</p>}@foreach(var t in tasks){<a class="list-link" href="/Tasks/Details/@t.Id"><span>@t.Title<small>@WorkRules.Date(t.DueDate) · @WorkRules.Label(t.DueDateType)</small></span><span class="badge">@WorkRules.Label(t.Status)</span></a>}<p class="muted">Lưu trữ dự án không xóa hay tự lưu trữ công việc trong dự án.</p><form asp-action="Archive" asp-route-id="@Model.Id" method="post"><input name="version" type="hidden" value="@Model.Version"/><button>Lưu trữ dự án</button></form></section><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>




