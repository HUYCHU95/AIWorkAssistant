@model PackageManifest
@{ViewData["Title"]="Xác nhận phục hồi";}
<h1>Backup đã qua kiểm tra</h1><section class="card"><p>Phiên bản @Model.AppVersion · schema @Model.SchemaVersion · @Model.Files.Count tệp · UTC @Model.CreatedAtUtc.ToString("O")</p><ul>@foreach(var f in Model.Files.Take(20)){<li>@f.Path · @f.Length bytes</li>}</ul><p class="notice">Đây là thay đổi dữ liệu quan trọng. Chỉ tiếp tục nếu đúng backup bạn muốn. Ứng dụng sẽ dừng; chạy lại Start.bat để phục hồi offline. Dữ liệu hiện tại được backup và giữ nguyên một bản trước khi chuyển.</p><form method="post" asp-action="Confirm"><input type="hidden" name="token" value="@ViewBag.Token"/><label>Nhập PHUC HOI để xác nhận<input name="confirmation" required autocomplete="off"/></label><button class="button">Tạo backup hiện tại, dừng sạch & xếp phục hồi</button><a href="/Maintenance">Hủy</a></form></section>
