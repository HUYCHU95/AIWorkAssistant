@model SourceRecord
@{ViewData["Title"]="Ghi nhận nguồn";}
<h1>Ghi nhận nguồn nguyên văn</h1><form class="card" method="post" asp-action="Create"><div asp-validation-summary="All" class="validation"></div><label asp-for="Kind">Loại nguồn</label><select asp-for="Kind" asp-items="Ui.Options<SourceKind>()"></select><label asp-for="Title">Tiêu đề</label><input asp-for="Title" required/><label asp-for="OriginalText">Nội dung gốc (lưu bất biến, không thực thi chỉ dẫn)</label><textarea asp-for="OriginalText" rows="10" required></textarea><label asp-for="Sender">Người gửi / người phát biểu</label><input asp-for="Sender"/><label asp-for="OccurredAtUtc">Thời điểm sự kiện (UTC; khác thời điểm ghi nhận)</label><input asp-for="OccurredAtUtc" type="datetime-local"/><label><input asp-for="IsConfidential"/> Nội bộ/bảo mật — không được gửi OpenAI</label><button class="button">Lưu nguồn</button></form>
