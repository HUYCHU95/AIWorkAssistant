@model SourceRecord
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><div class="eyebrow">@Model.Kind · @Model.Status</div><h1>@Model.Title</h1></div><a href="/Sources">← Nguồn & lịch sử</a></div><section class="card"><p>Người gửi: @(Model.Sender??"Chưa xác nhận") · @(Model.IsConfidential?"Nội bộ — không gửi AI":"Có thể chọn gửi AI")</p><p>Sự kiện: @(Model.OccurredAtUtc is {} occurred?WorkRules.LocalTime(occurred):"Chưa xác nhận") · Ghi nhận: @WorkRules.LocalTime(Model.CreatedAtUtc)</p><pre>@Model.OriginalText</pre><details><summary>Checksum nguồn bất biến</summary><code>@Model.OriginalSha256</code></details><h2>Trạng thái xử lý & quyền nguồn</h2><p class="muted">Nội dung, tiêu đề, người gửi và thời điểm nguồn không bị sửa. Bỏ chọn Nội bộ chỉ cho phép retrieval khi quyền AI bên ngoài cũng đã bật; không tự gửi dữ liệu ngay.</p><form method="post" asp-action="UpdateMetadata" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><label>Trạng thái nguồn<select name="status">@foreach(var status in new[]{"Captured","Classified","Linked","Verified","Actioned","Archived"}){<option value="@status" selected="@(Model.Status==status)">@status</option>}</select></label><label><input type="checkbox" name="isConfidential" value="true" checked="@Model.IsConfidential"/> Nội bộ — không gửi AI</label><button>Lưu trạng thái & quyền nguồn</button></form><h2>Liên kết</h2>@foreach(SourceLink link in ViewBag.Links){<a class="list-link" href="/@(link.EntityType=="Project"?"Projects":link.EntityType=="Task"?"Tasks":"Tracking")/Details/@link.EntityId">@link.EntityType · @link.EntityId</a>}<form method="post" asp-action="Link" asp-route-id="@Model.Id"><label>Loại đích<select name="entityType"><option>Project</option><option>Task</option><option>TrackingEntry</option></select></label><label>ID đích<input name="entityId" required/></label><button>Liên kết nguồn</button></form><form method="post" asp-action="Archive" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><button>Lưu trữ nguồn</button></form></section><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>

