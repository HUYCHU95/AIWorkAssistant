<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · AIWork</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><div class="app-shell"><aside class="sidebar"><a class="brand" href="/">◈ <span>AIWork<small>PERSONAL WORK ASSISTANT</small></span></a><div class="workspace-label">KHÔNG GIAN CÁ NHÂN · V1.0</div><button type="button" id="nav-toggle" aria-controls="primary-navigation" aria-expanded="false">☰ Menu điều hướng</button><nav id="primary-navigation"><a href="/">◉ Tổng quan hôm nay</a><a href="/Inbox">↳ Inbox & ghi nhận</a><a href="/Memory">◷ Memory & dữ kiện</a><a href="/Chat">✦ AI Workspace</a><a href="/Projects">▦ Danh mục dự án</a><a href="/Planner">◴ Planner & thông báo</a><a href="/Tasks">☑ Trung tâm công việc</a><a href="/Workstreams">◇ Luồng công việc</a><a href="/Actions">✓ Đề xuất & phê duyệt</a><a href="/Tracking">◎ Vấn đề · Cam kết · Chỉ thị</a><a href="/Sources">▤ Nguồn & lịch sử</a><a href="/Dependencies">⇄ Phụ thuộc công việc</a><a href="/Import">↥ Nhập dữ liệu Excel</a><a href="/Settings">⚙ Cài đặt & sao lưu</a></nav><div class="sidebar-foot"><span class="online">●</span> Dữ liệu lưu trên máy<br/><small>SQLite · Không cần kết nối mạng</small><p>AI · chỉ hoạt động khi bật cấu hình và quyền dữ liệu</p></div></aside>
<div class="main-shell"><header><form action="/Tasks" method="get" class="search"><input aria-label="Tìm công việc" name="q" placeholder="Tìm công việc, từ khóa…"/><button>Tìm</button></form><div class="user">@if(User.Identity?.IsAuthenticated == true){<span>@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="text-button">Đăng xuất</button></form>}else{<span>Tài khoản cục bộ</span>}</div></header><main>@if(TempData["Message"] is string message){<div class="notice" role="status">@message</div>}@RenderBody()</main><footer>AIWork V1.0 · Nguồn dữ liệu: SQLite cục bộ · Giờ Việt Nam (UTC+7)</footer></div></div><script src="~/js/site.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts", required:false)</body></html>






