@using Microsoft.EntityFrameworkCore
@inject WorkDb Db
@{var appearance=await Db.Experience.AsNoTracking().SingleOrDefaultAsync()??new ExperienceSettings();var controller=ViewContext.RouteData.Values["controller"]?.ToString()??"Home";var area=controller switch{"Home" or "Dashboard"=>"home","Chat" or "Inbox" or "Memory" or "Sources" or "Analysis" or "Documents"=>"ai","Planner" or "Reports"=>"planning","Settings" or "Appearance" or "Integrations" or "Maintenance" or "Profile"=>"settings",_=>"work"};}
<!DOCTYPE html><html lang="vi" data-theme="@appearance.Theme.ToLowerInvariant()" data-area="@area"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · AIWork</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="/Appearance/Styles"/></head>
<body data-controller="@controller"><div class="app-shell"><aside class="sidebar"><a class="brand" href="/">◈ <span>AIWork<small>PERSONAL WORKSPACE</small></span></a><button id="nav-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false">☰ Menu điều hướng</button><nav id="primary-navigation" aria-label="Điều hướng chính"><a class="nav-home @(area=="home"?"active":"")" href="/">◉ Dashboard</a>
<details open="@(area=="ai")"><summary>✦ AI Workspace</summary><a class="@(controller=="Chat"?"active":"")" href="/Chat">Hội thoại AI</a><a class="@(controller=="Analysis"?"active":"")" href="/Analysis">Phân tích file & tự điền</a><a href="/Inbox">Inbox · email · biên bản</a><a href="/Memory">Memory & dữ kiện</a><a href="/Sources">Nguồn & tài liệu</a><a href="/Actions">Đề xuất chờ duyệt</a></details>
<details open="@(area=="work")"><summary>▦ Work Management</summary><a href="/Projects">Dự án</a><a href="/Tasks">Công việc</a><a href="/Workstreams">Luồng công việc</a><a href="/Tracking?kind=Issue">Vấn đề</a><a href="/Tracking?kind=Commitment">Cam kết</a><a href="/Tracking?kind=Instruction">Chỉ thị</a><a href="/Tracking?kind=Decision">Quyết định</a><a href="/Dependencies">Phụ thuộc công việc</a></details>
<details open="@(area=="planning")"><summary>◴ Planning & Reports</summary><a href="/Planner">Planner & nhắc việc</a><a href="/#timeline">Timeline & kế hoạch</a><a href="/#project-progress">Tiến độ & KPI</a><a href="/Import">Nhập workbook</a></details>
<details open="@(area=="settings")"><summary>⚙ Settings</summary><a href="/Appearance">Giao diện & màu sắc</a><a href="/Integrations">AI & email</a><a href="/Settings">Sao lưu dữ liệu</a><a href="/Maintenance">Phục hồi & chẩn đoán</a><a href="/Profile">Tài khoản</a></details></nav><div class="sidebar-foot"><span class="online">●</span> SQLite cục bộ · Portable<small>Dữ liệu được lưu tại máy của bạn</small></div></aside><div class="main-shell"><header><button id="sidebar-collapse" type="button" aria-label="Thu gọn sidebar">☰</button><form action="/Tasks" method="get" class="search"><input aria-label="Tìm công việc" name="q" placeholder="Tìm dự án, công việc, từ khóa…"/><button>Tìm</button></form><div class="user">@if(User.Identity?.IsAuthenticated==true){<a href="/Planner" title="Thông báo">◴</a><span>@User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="text-button">Đăng xuất</button></form>}else{<span>Tài khoản cục bộ</span>}</div></header><main>@if(TempData["Message"] is string message){<div class="notice" role="status">@message</div>}@RenderBody()</main><footer>AIWork V1.1.1 · SQLite cục bộ · Giờ Việt Nam (UTC+7)</footer></div></div><script src="~/js/site.js" asp-append-version="true" defer></script><script src="~/js/ai-entry.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
