@model MemoryFact
@{ViewData["Title"]="Ghi nhận dữ kiện";}
<h1>Ghi nhận dữ kiện có nguồn</h1><form method="post" asp-action="Create" class="card"><div asp-validation-summary="All" class="validation"></div><label asp-for="SubjectType">Loại chủ thể</label><select asp-for="SubjectType"><option>Project</option><option>Task</option><option>TrackingEntry</option></select><label asp-for="SubjectId">ID chủ thể</label><input asp-for="SubjectId" required/><label asp-for="Predicate">Thuộc tính / chủ đề (ví dụ delivery_promise, frame_revision)</label><input asp-for="Predicate" required/><label asp-for="ValueText">Giá trị nguyên nghĩa — chưa tự xác minh</label><textarea asp-for="ValueText" rows="4" required></textarea><label asp-for="SourceId">Nguồn</label><select asp-for="SourceId">@foreach(SourceRecord s in ViewBag.Sources){<option value="@s.Id">@s.Title</option>}</select><label asp-for="EffectiveAtUtc">Có hiệu lực từ (UTC; nếu biết)</label><input asp-for="EffectiveAtUtc" type="datetime-local"/><button class="button">Lưu báo cáo / phát hiện xung đột</button></form>
