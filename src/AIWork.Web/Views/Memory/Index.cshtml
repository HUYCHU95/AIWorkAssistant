@model List<MemoryFact>
@{ViewData["Title"]="Memory & phiên bản dữ kiện";}
<div class="page-heading"><h1>Memory & dữ kiện theo thời gian</h1><a class="button" href="/Memory/Create">+ Ghi nhận dữ kiện</a></div><div class="tabs"><a href="/Memory">Tất cả phiên bản</a><a href="/Memory?conflicts=true">Xung đột cần xác minh</a><a href="/Sources">Nguồn nguyên bản</a></div><form class="filters" method="get"><input name="q" placeholder="Tìm giá trị / chủ đề…"/><button>Tìm</button></form><section class="card">@foreach(var f in Model){<a class="list-link" href="/Memory/Details/@f.Id"><span>@f.Predicate: @f.ValueText<small>@f.SubjectType · @f.SubjectId · @(f.IsCurrent?"Hiện tại":"Phiên bản trước")</small></span><span class="badge">@f.Verification</span></a>}@if(Model.Count==0){<p class="empty">Chưa có dữ kiện. Ghi nhận từ nguồn hoặc Inbox; không tự tạo sự thật từ suy đoán.</p>}</section>
