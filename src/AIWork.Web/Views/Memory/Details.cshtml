@model MemoryFact
@{ViewData["Title"]=Model.Predicate;}
<div class="page-heading"><div><div class="eyebrow">@Model.Verification · @(Model.IsCurrent?"HIỆN TẠI":"ĐÃ THAY THẾ")</div><h1>@Model.Predicate</h1></div><a href="/Memory">← Memory</a></div><section class="card"><p class="preserve">@Model.ValueText</p><p>Có hiệu lực: @(Model.EffectiveAtUtc is {} d?WorkRules.LocalTime(d):"Chưa rõ") · Ghi nhận: @WorkRules.LocalTime(Model.CreatedAtUtc)</p><p>@Model.ConfidenceNotes</p><a href="/Sources/Details/@Model.SourceId">Xem nguồn gốc</a>@if(Model.ConflictsWithId!=null){<p class="notice">Khác dữ kiện hiện tại. <a href="/Memory/Details/@Model.ConflictsWithId">Xem dữ kiện đối chiếu</a>. Mốc cam kết dự án không bị tự ghi đè.</p>}@if(Model.SupersededById!=null){<a href="/Memory/Details/@Model.SupersededById">Xem phiên bản thay thế</a>}@if(Model.Verification!=Verification.Superseded){<form method="post" asp-action="Verify" asp-route-id="@Model.Id"><input name="version" type="hidden" value="@Model.Version"/><label>Lý do / bằng chứng xác minh<input name="reason" maxlength="1000" required/></label><button class="button">Tôi xác minh dữ kiện này là phiên bản hiện tại</button></form>}<h2>Phiên bản</h2>@foreach(MemoryRevision revision in ViewBag.Revisions){<details><summary>@WorkRules.LocalTime(revision.CreatedAtUtc) · @revision.Reason</summary><pre>@revision.BeforeJson</pre><pre>@revision.AfterJson</pre></details>}</section><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>
