@model TrackingEntry
@{ViewData["Title"]="Hồ sơ theo dõi";}
<h1>@Ui.TrackingName(Model.Kind)</h1><partial name="_AIEntry"/>
<form class="card editor" method="post" asp-action="Edit" asp-route-id="@Model.Id"><input asp-for="Id" type="hidden"/><input asp-for="Kind" type="hidden"/><input asp-for="Version" type="hidden"/><div asp-validation-summary="All" class="validation"></div><label asp-for="Title">Tiêu đề / kết quả cần giao *</label><input asp-for="Title" required/><label asp-for="Content">Nội dung / chỉ thị nguyên văn / quyết định *</label><textarea asp-for="Content" rows="6" required></textarea><div class="grid"><div><label asp-for="ProjectId">Dự án</label><select asp-for="ProjectId"><option value="">Độc lập</option>@foreach(Project p in ViewBag.Projects){<option value="@p.Id">@p.Name</option>}</select></div><div><label asp-for="TaskId">ID công việc liên quan (tùy chọn)</label><input asp-for="TaskId"/></div><div><label asp-for="SourceId">Nguồn / bằng chứng</label><select asp-for="SourceId"><option value="">Chưa có</option>@foreach(SourceRecord s in ViewBag.Sources){<option value="@s.Id">@s.Title</option>}</select></div><div><label asp-for="PersonText">Người liên quan / người cam kết / người ra chỉ thị</label><input asp-for="PersonText"/></div><div><label asp-for="Status">Trạng thái</label><select asp-for="Status" asp-items="Ui.Options<TrackingStatus>()"></select></div><div><label asp-for="Verification">Mức xác minh</label><select asp-for="Verification" asp-items="Ui.Options<Verification>()"></select></div><div><label asp-for="Severity">Mức độ / ưu tiên</label><select asp-for="Severity" asp-items="Ui.Options<Priority>()"></select></div><div><label asp-for="TargetDate">Ngày hẹn / hạn</label><input asp-for="TargetDate" type="date"/></div><div><label asp-for="DueDateType">Loại hạn</label><select asp-for="DueDateType" asp-items="Ui.Options<DeadlineType>()"><option value="">Chưa có ngày</option></select></div><div><label asp-for="NextCheckAtUtc">Lần kiểm tra tiếp (UTC)</label><input asp-for="NextCheckAtUtc" type="datetime-local"/></div></div><label asp-for="RootCause">Nguyên nhân / lý do quyết định</label><textarea asp-for="RootCause"></textarea><label asp-for="NextAction">Hướng xử lý / bước tiếp theo</label><textarea asp-for="NextAction"></textarea>@if(Model.Kind==TrackingKind.Decision){<label asp-for="SupersedesId">ID quyết định trước được thay thế</label><input asp-for="SupersedesId"/>}<button class="button">Lưu hồ sơ</button></form>
