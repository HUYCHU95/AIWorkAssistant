@model TrackingEntry
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><div class="eyebrow">@Ui.TrackingName(Model.Kind) · @Model.Status · @Model.Verification</div><h1>@Model.Title</h1></div><a class="button" href="/Tracking/Edit/@Model.Id">Chỉnh sửa</a></div><section class="card"><p class="preserve">@Model.Content</p><dl><dt>Người liên quan</dt><dd>@(Model.PersonText??"Chưa xác nhận")</dd><dt>Hạn</dt><dd>@WorkRules.Date(Model.TargetDate) · @WorkRules.Label(Model.DueDateType)</dd><dt>Lần kiểm tra tiếp</dt><dd>@(Model.NextCheckAtUtc is {} date?WorkRules.LocalTime(date):"Chưa hẹn")</dd></dl><p>@Model.RootCause</p><p>@Model.NextAction</p>@if(Model.ProjectId!=null){<a class="button secondary" href="/Projects/Details/@Model.ProjectId">Mở dự án</a>}@if(Model.TaskId!=null){<a class="button secondary" href="/Tasks/Details/@Model.TaskId">Mở công việc</a>}@if(Model.SourceId!=null){<a class="button secondary" href="/Sources/Details/@Model.SourceId">Xem nguồn</a>}<form method="post" asp-action="Archive" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><button>Lưu trữ hồ sơ</button></form></section><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>
