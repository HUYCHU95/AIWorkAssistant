@model List<TrackingEntry>
@{ViewData["Title"]="Theo dõi chuyên sâu";}
<div class="page-heading"><div><div class="eyebrow">WORK TRACKING</div><h1>@Ui.TrackingName((TrackingKind?)ViewBag.Kind)</h1><p class="muted">Báo cáo nguồn và xác minh thực tế được giữ riêng.</p></div><a class="button" href="/Tracking/Edit?kind=@ViewBag.Kind">+ Thêm hồ sơ</a></div><div class="tabs">@foreach(var kind in Enum.GetValues<TrackingKind>()){<a href="/Tracking?kind=@kind">@Ui.TrackingName(kind)</a>}</div><form method="get" class="filters"><input type="hidden" name="kind" value="@ViewBag.Kind"/><input name="q" placeholder="Tìm nội dung…"/><select name="status" asp-items="Ui.Options<TrackingStatus>()"><option value="">Mọi trạng thái</option></select><button>Lọc</button></form><section class="card">@if(Model.Count==0){<p class="empty">Chưa có hồ sơ phù hợp. Tạo hồ sơ hoặc ghi nhận từ Inbox.</p>}@foreach(var item in Model){<a class="list-link" href="/Tracking/Details/@item.Id"><span>@item.Title<small>@Ui.TrackingName(item.Kind) · @(item.PersonText??"Chưa xác nhận PIC")</small></span><span>@WorkRules.Label(item.Status) · @WorkRules.Date(item.TargetDate)<small>@WorkRules.Label(item.DueDateType) · @item.Verification</small></span></a>}</section>
