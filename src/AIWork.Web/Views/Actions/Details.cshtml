@model ActionReceipt
@{ViewData["Title"]="Phiếu hành động";}
<div class="page-heading"><div><div class="eyebrow">@Model.RiskLevel · @Model.ToolName</div><h1>@Model.Status</h1><p>@Model.Summary</p></div><a href="/Actions">← Hàng đợi</a></div><section class="card"><h2>Nội dung đề xuất — đọc trước khi xác nhận</h2><pre>@Model.ArgumentsJson</pre><p>Người duyệt: @(Model.ReviewedBy??"Chưa duyệt") · @WorkRules.LocalTime(Model.CreatedAtUtc)</p>@if(Model.Status=="PendingApproval"){<form method="post" asp-action="Approve" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><button class="button">Tôi xác nhận đúng nội dung — thực hiện</button></form>}@if(Model.Status is "PendingApproval" or "NeedsReview"){<form method="post" asp-action="Reject" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><button>Từ chối đề xuất</button></form>}@if(Model.Status=="Executed"&&Model.AppliedVersion!=null){<form method="post" asp-action="Undo" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><button>Hoàn tác an toàn nếu chưa bị sửa tiếp</button></form>}@if(Model.EntityId!=null){<p><a href="/@(Model.EntityType=="Task"?"Tasks":Model.EntityType=="Project"?"Projects":Model.EntityType=="Workstream"?"Workstreams":Model.EntityType=="Source"?"Sources":Model.EntityType=="Reminder"?"Planner":"Tracking")/Details/@Model.EntityId">Mở bản ghi kết quả</a></p>}@if(Model.OriginSourceId!=null){<a href="/Sources/Details/@Model.OriginSourceId">Mở nguồn gốc</a>}<details><summary>Trước / sau</summary><pre>@Model.BeforeJson</pre><pre>@Model.AfterJson</pre></details></section><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>
