@model Workstream
@{ViewData["Title"]=Model.Name;}
<div class="page-heading"><div><div class="eyebrow">@Model.Code · @WorkRules.Label(Model.Status)</div><h1>@Model.Name</h1></div><a class="button" href="/Workstreams/Edit/@Model.Id">Chỉnh sửa</a></div><section class="card"><p>@Model.Description</p><h2>Dự án trong luồng</h2>@foreach(Project p in ViewBag.LinkedProjects){<a class="list-link" href="/Projects/Details/@p.Id">@p.Name</a>}<h2>Công việc độc lập trong luồng</h2>@foreach(WorkTask t in ViewBag.LinkedTasks){<a class="list-link" href="/Tasks/Details/@t.Id">@t.Title</a>}<p class="muted">Lưu trữ luồng giữ nguyên dự án, công việc và lịch sử.</p><form asp-action="Archive" asp-route-id="@Model.Id" method="post"><input name="version" type="hidden" value="@Model.Version"/><button>Lưu trữ luồng</button></form></section><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>
