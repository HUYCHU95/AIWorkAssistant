@model AIWork.Web.Controllers.IntegrationSettings
@{ViewData["Title"]="Cấu hình tích hợp";}
<h1>AI & SMTP — cấu hình cục bộ</h1><p class="notice">API key/SMTP password được mã hóa Windows DPAPI theo tài khoản hiện tại, không hiển thị lại và không đưa vào backup. Chuyển máy cần nhập lại. Chưa gửi dữ liệu cho đến khi bật quyền xử lý bên ngoài riêng biệt.</p><form class="card" method="post" asp-action="Save"><h2>OpenAI Responses API</h2><p>Khóa đã cấu hình: @ViewBag.KeyConfigured</p><label asp-for="ApiKey">API key mới (để trống giữ nguyên)</label><input asp-for="ApiKey" autocomplete="new-password"/><label asp-for="Preferences.Model">Model ID được tài khoản API của bạn hỗ trợ</label><input asp-for="Preferences.Model" maxlength="100"/><label><input asp-for="Preferences.AIEnabled"/> Bật tích hợp AI</label><label><input asp-for="Preferences.AllowExternalAIProcessing"/> Tôi cho phép gửi câu hỏi và dữ liệu ngữ cảnh được chọn tới OpenAI theo chính sách dữ liệu của mình. Nguồn Nội bộ luôn bị loại.</label><div class="grid"><div><label asp-for="Preferences.MonthlyTokenLimit">Giới hạn token tháng (chặn yêu cầu mới sau ngưỡng)</label><input asp-for="Preferences.MonthlyTokenLimit" type="number"/></div><div><label asp-for="Preferences.InputUsdPerMillion">USD/triệu input token (tùy chọn, do bạn nhập)</label><input asp-for="Preferences.InputUsdPerMillion" type="number" step="0.0001"/></div><div><label asp-for="Preferences.OutputUsdPerMillion">USD/triệu output token (tùy chọn)</label><input asp-for="Preferences.OutputUsdPerMillion" type="number" step="0.0001"/></div></div><h2>Nhắc việc & SMTP tùy chọn</h2><label><input asp-for="Preferences.WorkerEnabled"/> Bật lịch nhắc trong ứng dụng khi ứng dụng đang chạy</label><label asp-for="Preferences.MorningHour">Giờ briefing sáng (giờ Việt Nam)</label><input asp-for="Preferences.MorningHour" type="number"/><label asp-for="Preferences.EveningHour">Giờ briefing chiều</label><input asp-for="Preferences.EveningHour" type="number"/><label><input asp-for="Preferences.SmtpEnabled"/> Bật SMTP (chỉ gửi khi có xác nhận gửi cụ thể)</label><div class="grid"><div><label asp-for="Preferences.SmtpHost">SMTP host</label><input asp-for="Preferences.SmtpHost"/></div><div><label asp-for="Preferences.SmtpPort">Port STARTTLS</label><input asp-for="Preferences.SmtpPort" type="number"/></div><div><label asp-for="Preferences.SmtpUser">Username</label><input asp-for="Preferences.SmtpUser" autocomplete="off"/></div><div><label asp-for="SmtpPassword">SMTP password mới (để trống giữ nguyên)</label><input asp-for="SmtpPassword" autocomplete="new-password"/></div><div><label asp-for="Preferences.SmtpFrom">From email</label><input asp-for="Preferences.SmtpFrom" type="email"/></div><div><label asp-for="Preferences.SmtpRecipient">Người nhận email của bạn</label><input asp-for="Preferences.SmtpRecipient" type="email"/></div></div><label><input asp-for="Preferences.SmtpTls"/> Bắt buộc TLS khi dùng SMTP</label><label><input asp-for="Preferences.SmtpAutomaticReminders"/> Tôi cho phép tự gửi nội dung nhắc việc đến đúng người nhận đã cấu hình và test SMTP thành công. Mặc định tắt; không hoạt động trước khi test được xác nhận.</label><a href="/Planner">Gửi test SMTP có xác nhận & xem thông báo</a><button class="button">Lưu cấu hình — chưa gọi AI/gửi mail</button></form>

