@model List<ImportBatch>
@{ViewData["Title"]="Nhập dữ liệu Excel";}
<div class="page-heading"><div><div class="eyebrow">DỮ LIỆU CÓ NGUỒN GỐC</div><h1>Nhập workbook 9 dự án</h1><p class="muted">Xem trước → xác nhận → lưu SQLite. Không tự ghi đè dữ liệu hiện tại.</p></div></div>
<section class="card"><h2>Chọn workbook</h2><p>Hỗ trợ mẫu <code>Quan_ly_9_du_an</code>: 9 dự án, 60 đầu việc. Tệp .xlsx, tối đa 5 MB. Bản mẫu nằm trong thư mục sample-data.</p><form asp-action="Preview" method="post" enctype="multipart/form-data"><label for="file">Tệp Excel</label><input id="file" type="file" name="file" accept=".xlsx" required/><button class="button">Xem trước dữ liệu</button></form></section>
<section class="card"><h2>Mapping 9projects-v1</h2><p>Dự án: dòng 9–17, A=mã, B=luồng, C=tên. F/G/I/N giữ nguyên trong nguồn. Công việc: dòng 21–80, A=ID ổn định, B=dự án, C=tên, D=ngày, F=kết quả cần có, G=ưu tiên, N=loại hạn. PIC E giữ trong nguồn, không tự gán. “Theo kế hoạch” → Planned; còn lại → Suggested. Trạng thái nhập Planned/Todo; các số KPI/công thức không được nhập.</p><p class="muted">Nhập lại dùng mã dự án và ID đầu việc; bỏ qua bản ghi cũ, kể cả đã lưu trữ. Chỉnh sửa trong workbook không cập nhật bản ghi đã nhập.</p></section>
<section class="card table-wrap"><h2>Lịch sử nhập</h2><table><thead><tr><th>Thời gian / tệp</th><th>Tạo / bỏ qua</th><th>Nguồn & cảnh báo</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@WorkRules.LocalTime(b.ImportedAtUtc)<small>@b.SourceFileName</small></td><td>@b.CreatedCount / @b.SkippedCount</td><td><details><summary>@b.MappingVersion · SHA-256</summary><pre>@b.FileSha256</pre><pre>@b.WarningsJson</pre></details></td></tr>}</tbody></table>@if(Model.Count==0){<p class="empty">Chưa nhập workbook nào.</p>}</section>
