@model ImportPreview
@{ViewData["Title"]="Xem trước import";}
<div class="page-heading"><div><div class="eyebrow">CHƯA GHI DỮ LIỆU NGHIỆP VỤ</div><h1>Xem trước workbook</h1><p>@Model.FileName · @Model.Projects.Count dự án · @Model.Tasks.Count đầu việc</p></div></div>
<section class="card"><h2>Cần lưu ý trước khi xác nhận</h2>@foreach(var warning in Model.Warnings){<p class="notice">@warning</p>}<form asp-action="Confirm" method="post"><input type="hidden" name="token" value="@ViewBag.Token"/><button class="button">Xác nhận nhập @Model.Projects.Count dự án & @Model.Tasks.Count đầu việc</button><a class="button secondary" href="/Import">Hủy</a></form></section>
<section class="card table-wrap"><h2>9 dự án · trạng thái nhập: Kế hoạch</h2><table><thead><tr><th>Dòng / mã</th><th>Dự án / luồng</th><th>Giá trị nguồn cần xác minh</th></tr></thead><tbody>@foreach(var p in Model.Projects){<tr><td>@p.Row · @p.Code</td><td>@p.Name<small>@p.Workstream</small></td><td>@p.Source</td></tr>}</tbody></table></section>
<section class="card table-wrap"><h2>60 đầu việc · trạng thái nhập: Chưa bắt đầu</h2><table><thead><tr><th>Dòng / ID</th><th>Dự án / công việc</th><th>Hạn / loại</th><th>Ưu tiên</th><th>Nguồn</th></tr></thead><tbody>@foreach(var t in Model.Tasks){<tr><td>@t.Row · @t.Key</td><td><small>@t.ProjectName</small>@t.Title</td><td>@WorkRules.Date(t.Due)<small>@WorkRules.Label(t.Type)</small></td><td>@WorkRules.Label(t.Priority)</td><td><details><summary>Chi tiết</summary>@t.Source</details></td></tr>}</tbody></table></section>
