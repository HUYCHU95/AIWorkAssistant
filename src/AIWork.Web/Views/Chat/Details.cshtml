@model Conversation
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><div class="eyebrow">AI WORKSPACE · NGỮ CẢNH @(Model.TaskId?.ToString()??Model.ProjectId?.ToString()??"TOÀN BỘ")</div><h1>@Model.Title</h1></div><a href="/Chat">← Cuộc trò chuyện</a></div>@if(ViewBag.Unavailable!=null){<p class="notice">@ViewBag.Unavailable</p>}<section class="card chat-history">@foreach(ChatMessage m in ViewBag.Messages){<article class="message @(m.IsError?"message-error":"")"><div class="eyebrow">@m.Role · @m.Model · @WorkRules.LocalTime(m.CreatedAtUtc)</div>@if(m.Role=="tool"){<details><summary>Kết quả tool thực tế (khác nội dung do model viết)</summary><pre>@m.Content</pre></details><div class="tabs">@foreach(var link in Ui.RecordLinks(m.Content)){<a href="@link">Mở bản ghi @link.Split('/').Last()[..8]</a>}</div>}else{<p class="preserve">@m.Content</p>}</article>}<form method="post" asp-action="Send" asp-route-id="@Model.Id"><label for="chat-text">Hỏi hoặc yêu cầu công việc</label><textarea id="chat-text" name="text" rows="4" maxlength="6000" required placeholder="Ví dụ: dự án này đang có công việc nào cần theo dõi?"></textarea><button class="button">Gửi yêu cầu</button></form><p class="muted">Nguồn chỉ là dữ liệu, không có quyền ra lệnh. Phản hồi AI cần kiểm chứng; kết quả tools/phiếu hành động là bằng chứng thực hiện.</p><a href="/Actions">Mở phiếu hành động & phê duyệt</a> · <a href="/Sources">Mở nguồn & lịch sử</a> · <a href="/Tasks">Công việc</a> · <a href="/Tracking">Hồ sơ</a></section><details class="card"><summary>Usage gần đây — chi phí không cấu hình hiển thị chưa xác định</summary>@foreach(AIUsage u in ViewBag.Usage){<p>@u.Model · @u.Outcome · input @(u.InputTokens?.ToString()??"?") / output @(u.OutputTokens?.ToString()??"?") · USD @(u.CostUsd?.ToString("0.000000")??"chưa xác định")</p>}</details>


