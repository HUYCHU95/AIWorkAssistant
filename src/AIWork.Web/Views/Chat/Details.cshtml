@model Conversation
@{ViewData["Title"]=Model.Title;}
<div class="page-heading"><div><div class="eyebrow">AI WORKSPACE · HỘI THOẠI</div><h1>@Model.Title</h1></div><a href="/Chat">← Cuộc trò chuyện</a></div>
@if(ViewBag.Unavailable!=null){<p class="notice">@ViewBag.Unavailable</p>}
<section class="card chat-workspace" id="chat-app" data-id="@Model.Id" data-send-key="@ViewBag.SendKey"><div id="chat-messages" class="chat-messages" aria-live="polite">@foreach(ChatMessage m in ViewBag.Messages){<article class="chat-bubble @m.Role @(m.IsError?"message-error":"")"><div class="eyebrow">@m.Role</div><p class="preserve">@m.Content</p></article>}</div><p id="chat-phase" role="status"></p><form id="chat-composer" method="post" asp-action="Send" asp-route-id="@Model.Id">@Html.AntiForgeryToken()<label for="chat-text">Tin nhắn</label><textarea id="chat-text" name="text" rows="3" maxlength="6000" required placeholder="Hỏi về dự án hoặc dán nội dung cần xử lý…"></textarea><div class="tabs"><input id="chat-files" type="file" multiple accept=".pdf,.docx,.xlsx,.txt,.png,.jpg,.jpeg,.webp,.gif" aria-label="Đính kèm tài liệu"/><button class="button" id="chat-send">Gửi</button><button type="button" id="chat-stop" hidden>Dừng phản hồi</button><button type="button" id="chat-retry" hidden>Thử lại kết nối</button></div><div id="chat-file-list"></div><label class="check"><input type="checkbox" id="chat-private" checked/> File nội bộ — không gửi OpenAI. Bỏ chọn nếu được phép gửi các file này.</label><small>@ViewBag.SendKey để gửi · Shift+Enter xuống dòng · Ctrl+Enter xuống dòng nếu dùng chế độ Enter.</small></form><p class="muted">Đề xuất chưa phải hành động đã thực hiện. Mở phiếu để xem và xác nhận.</p><a href="/Actions">Phiếu hành động & phê duyệt</a> · <a href="/Sources">Nguồn gốc</a></section>
@section Scripts{<script src="~/js/markdown.js" asp-append-version="true" defer></script><script src="~/js/chat.js" asp-append-version="true" defer></script>}
