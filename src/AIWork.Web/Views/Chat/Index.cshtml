@model List<Conversation>
@{ViewData["Title"]="AI Workspace";}
<div class="page-heading"><div><div class="eyebrow">OPENAI RESPONSES · LỊCH SỬ LƯU CỤC BỘ</div><h1>AI Workspace</h1></div><a href="/Integrations">Cài đặt AI & quyền dữ liệu</a></div>@if(ViewBag.Unavailable!=null){<p class="notice">@ViewBag.Unavailable</p>}<div class="grid"><section class="card"><h2>Cuộc trò chuyện mới</h2><form method="post" asp-action="Create"><label>Tiêu đề<input name="title" maxlength="200" required/></label><label>Ngữ cảnh<select name="projectId"><option value="">Toàn bộ công việc được phép</option>@foreach(Project p in ViewBag.Projects){<option value="@p.Id" selected="@(ViewBag.DefaultProject!=null&&(Guid)ViewBag.DefaultProject==p.Id)">@p.Name</option>}</select></label><label>ID công việc (tùy chọn)<input name="taskId" value="@ViewBag.DefaultTask"/></label><button class="button">Tạo cuộc trò chuyện</button></form><p class="muted">Chỉ gửi dữ liệu khi bạn bật AI và cho phép xử lý bên ngoài. Nguồn đánh dấu Nội bộ không được gửi qua tools.</p></section><section class="card"><h2>Mở lại lịch sử</h2><form method="get" class="search"><input name="q" placeholder="Tìm cuộc trò chuyện/nội dung…"/><button>Tìm</button></form>@foreach(var c in Model){<a class="list-link" href="/Chat/Details/@c.Id"><span>@c.Title<small>@WorkRules.LocalTime(c.UpdatedAtUtc)</small></span></a>}@if(Model.Count==0){<p class="empty">Chưa có cuộc trò chuyện.</p>}</section></div>

