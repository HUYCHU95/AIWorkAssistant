@model List<InboxItem>
@{ViewData["Title"]="Inbox";var sources=(List<SourceRecord>)ViewBag.Sources;}
<div class="page-heading"><div><div class="eyebrow">THU THẬP → RÀ SOÁT → HÀNH ĐỘNG</div><h1>Inbox</h1></div><a class="button" href="/Inbox/Capture">+ Dán email / họp / ghi chú</a></div><form method="get" class="filters"><input name="q" placeholder="Tìm trong nội dung gốc…"/><select name="status"><option value="">Mọi trạng thái</option><option>NeedsReview</option><option>Processed</option></select><button>Lọc</button></form><section class="card">@foreach(var i in Model){var s=sources.FirstOrDefault(s=>s.Id==i.SourceId);<a class="list-link" href="/Inbox/Details/@i.Id"><span>@s?.Title<small>@i.ReviewReason</small></span><span class="badge">@i.Status</span></a>}@if(Model.Count==0){<p class="empty">Chưa có nội dung. Dán email hoặc ghi chú để giữ nguồn và rà soát đầu việc.</p>}</section>
