@model AIWork.Web.Controllers.CaptureInput
@{ViewData["Title"]="Ghi nhận Inbox";}
<h1>Ghi nhận Inbox</h1><form class="card" method="post" asp-action="Capture" enctype="multipart/form-data"><input asp-for="CaptureKey" type="hidden"/><div asp-validation-summary="All" class="validation"></div><label asp-for="Kind">Loại nội dung</label><select asp-for="Kind" asp-items="Ui.Options<SourceKind>()"></select><label asp-for="Title">Tiêu đề</label><input asp-for="Title" required/><label asp-for="Body">Nội dung nguyên văn</label><textarea asp-for="Body" rows="12" maxlength="60000" required></textarea><p class="muted">Checklist “1. việc”, “- [ ] việc”, “TASK: việc” có thể trích theo quy tắc để bạn duyệt; chưa tự gán PIC/hạn. Nội dung nguồn không có quyền ra lệnh cho hệ thống.</p><div class="grid"><div><label asp-for="Sender">Người gửi / người phát biểu</label><input asp-for="Sender"/></div><div><label asp-for="OccurredAtUtc">Thời điểm nguồn (UTC)</label><input asp-for="OccurredAtUtc" type="datetime-local"/></div><div><label asp-for="ProjectId">Dự án đã xác nhận (tùy chọn)</label><select asp-for="ProjectId"><option value="">Chưa liên kết</option>@foreach(Project p in ViewBag.Projects){<option value="@p.Id">@p.Name</option>}</select></div></div><label><input asp-for="IsConfidential"/> Nội bộ/bảo mật — không gửi OpenAI</label><label asp-for="Files">Tệp đính kèm (tối đa 8 tệp × 5 MB; txt/pdf/docx/xlsx/png/jpg)</label><input asp-for="Files" type="file" multiple/><p class="muted">Trích văn bản TXT/PDF/Word/Excel cục bộ. Ảnh và bản scan cần quyền gửi OpenAI để phân tích; không tự suy đoán nội dung.</p><button class="button">Lưu nguyên bản vào Inbox</button></form>
