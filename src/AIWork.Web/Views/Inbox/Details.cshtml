@model InboxItem
@{ViewData["Title"]="Rà soát Inbox";var source=(SourceRecord)ViewBag.Source;}
<div class="page-heading"><div><div class="eyebrow">@Model.Status · @source.Kind</div><h1>@source.Title</h1></div><a href="/Inbox">← Inbox</a></div><p class="notice">@Model.ReviewReason</p><section class="card"><h2>Nguồn bất biến</h2><p>@WorkRules.LocalTime(source.CreatedAtUtc) · @(source.IsConfidential?"Nội bộ — không gửi AI":"Có thể chọn gửi AI")</p><pre>@source.OriginalText</pre><a href="/Sources/Details/@source.Id">Nguồn, checksum & liên kết</a> · <a href="/Memory/Create?sourceId=@source.Id">Ghi nhận dữ kiện từ nguồn</a><form method="post" asp-action="Extract" asp-route-id="@Model.Id"><button class="button">Trích checklist cục bộ để rà soát</button></form><h2>Tệp đính kèm</h2>@foreach(DocumentRecord d in ViewBag.Documents){<div class="activity"><a href="/Documents/Download/@d.Id">@d.OriginalFileName</a><small>@d.LengthBytes bytes · @d.ExtractionStatus</small>@if(d.ExtractedText!=null){<details><summary>Text UTF-8 đã trích</summary><pre>@d.ExtractedText</pre></details>}</div>}<h2>Đề xuất liên quan</h2>@foreach(ActionReceipt a in ViewBag.Actions){<a class="list-link" href="/Actions/Details/@a.Id"><span>@a.ToolName<small>@a.Summary</small></span><span>@a.Status</span></a>}<form method="post" asp-action="Complete" asp-route-id="@Model.Id"><input type="hidden" name="version" value="@Model.Version"/><button>Đánh dấu đã rà soát nguồn (không hoàn thành công việc)</button></form></section>
