@model List<WorkTask>
@{ViewData["Title"]="Trung tâm công việc";var projects=(List<Project>)ViewBag.Projects;}
<div class="page-heading"><div><div class="eyebrow">TASK CENTER · @Model.Count KẾT QUẢ</div><h1>Trung tâm công việc</h1><p class="muted">Công việc dự án, theo luồng hoặc độc lập — cùng một nguồn dữ liệu.</p></div><a class="button" href="/Tasks/Edit">+ Thêm công việc</a></div>
<div class="tabs"><a href="/Tasks">Tất cả</a><a href="/Tasks?due=today">Hôm nay</a><a href="/Tasks?due=overdue">Quá hạn</a><a href="/Tasks?status=Waiting">Chờ xác nhận</a><a href="/Tasks?status=Blocked">Vướng mắc</a><a href="/Tasks?due=review">Cần bổ sung</a></div>
<form class="filters" method="get"><input name="q" value="@Context.Request.Query["q"]" placeholder="Tên việc, mô tả, bước tiếp…"/><select name="project" aria-label="Dự án"><option value="">Mọi dự án</option>@foreach(var p in projects){<option value="@p.Id" selected="@(Context.Request.Query["project"]==p.Id.ToString())">@p.Name</option>}</select><select name="status" aria-label="Trạng thái"><option value="">Mọi trạng thái</option>@foreach(var s in Enum.GetValues<WorkStatus>()){<option value="@s" selected="@(Context.Request.Query["status"]==s.ToString())">@WorkRules.Label(s)</option>}</select><input name="owner" value="@Context.Request.Query["owner"]" placeholder="Người phụ trách"/><select name="due" aria-label="Hạn"><option value="">Mọi ngày hạn</option><option value="today" selected="@(Context.Request.Query["due"]=="today")">Hôm nay</option><option value="overdue" selected="@(Context.Request.Query["due"]=="overdue")">Quá hạn</option><option value="week" selected="@(Context.Request.Query["due"]=="week")">7 ngày tới</option><option value="review" selected="@(Context.Request.Query["due"]=="review")">Thiếu thông tin</option></select><select name="sort" aria-label="Sắp xếp"><option value="">Theo hạn</option><option value="priority" selected="@(Context.Request.Query["sort"]=="priority")">Theo ưu tiên</option><option value="updated" selected="@(Context.Request.Query["sort"]=="updated")">Mới cập nhật</option></select><label><input type="checkbox" name="archived" value="true" checked="@(Context.Request.Query["archived"]=="true")"/> Gồm lưu trữ</label><button>Lọc</button><a href="/Tasks">Đặt lại</a></form>
<div class="card table-wrap"><table><thead><tr><th>Công việc / Bước tiếp theo</th><th>Dự án</th><th>Phụ trách</th><th>Ngày hạn / loại hạn</th><th>Ưu tiên</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>@foreach(var t in Model){<tr><td><a href="/Tasks/Details/@t.Id">@t.Title</a><small>@t.NextAction @(t.ArchivedAtUtc!=null?"· Đã lưu trữ":"")</small></td><td>@(projects.FirstOrDefault(p=>p.Id==t.ProjectId)?.Name??(t.ProjectId!=null?"Dự án đã lưu trữ":"Độc lập / theo luồng"))</td><td>@(t.OwnerText??"Chưa xác nhận")</td><td class="@(t.IsOverdue(WorkRules.Today)?"danger":"")">@WorkRules.Date(t.DueDate)<small>@WorkRules.Label(t.DueDateType)</small></td><td>@WorkRules.Label(t.Priority)</td><td><span class="badge">@WorkRules.Label(t.Status)</span></td><td>@WorkRules.LocalTime(t.UpdatedAtUtc)</td></tr>}</tbody></table>@if(Model.Count==0){<div class="empty">Không có công việc phù hợp. Thử đổi bộ lọc hoặc thêm công việc mới.</div>}</div>
