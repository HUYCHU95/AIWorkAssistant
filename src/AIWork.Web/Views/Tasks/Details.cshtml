@model WorkTask
@{ViewData["Title"]=Model.Title;var projects=(List<Project>)ViewBag.Projects;var streams=(List<Workstream>)ViewBag.Workstreams;var project=projects.FirstOrDefault(p=>p.Id==Model.ProjectId);}
<div class="page-heading"><div><div class="eyebrow">@WorkRules.Label(Model.Priority) · @WorkRules.Label(Model.Status) @(Model.ArchivedAtUtc!=null?"· Đã lưu trữ":"")</div><h1>@Model.Title</h1></div><a class="button" href="/Tasks/Edit/@Model.Id">Chỉnh sửa / đổi trạng thái</a></div>
<div class="grid"><section class="card"><h2>Thông tin theo dõi</h2><dl><dt>Dự án</dt><dd>@if(Model.ProjectId!=null){<a href="/Projects/Details/@Model.ProjectId">@(project?.Name??"Dự án đã lưu trữ")</a>}else{<span>Không có</span>}</dd><dt>Luồng công việc</dt><dd>@(streams.FirstOrDefault(w=>w.Id==(project?.WorkstreamId??Model.WorkstreamId))?.Name??"Không có / đã lưu trữ")</dd><dt>Người phụ trách</dt><dd>@(Model.OwnerText??"Chưa xác nhận")</dd><dt>Bắt đầu</dt><dd>@WorkRules.Date(Model.StartDate)</dd><dt>Ngày hạn</dt><dd class="@(Model.IsOverdue(WorkRules.Today)?"danger":"")">@WorkRules.Date(Model.DueDate) · @WorkRules.Label(Model.DueDateType)</dd><dt>Cập nhật</dt><dd>@WorkRules.LocalTime(Model.UpdatedAtUtc)</dd></dl>@if(Model.Status==WorkStatus.Done){<p>Hoàn thành: @(Model.CompletedAtUtc.HasValue?WorkRules.LocalTime(Model.CompletedAtUtc.Value):"Chưa có thời điểm")</p><p>@(string.IsNullOrWhiteSpace(Model.CompletionEvidence)?"Chưa có bằng chứng hoàn thành.":Model.CompletionEvidence)</p>}</section><section class="card"><h2>Mô tả</h2><p class="preserve">@(Model.Description??"Chưa có mô tả.")</p><p>Người theo dõi: @(Model.FollowUpPersonText??"Chưa xác nhận")</p><p>Đang chờ: @Model.WaitingFor</p><p>Cản trở: @Model.Blocker</p><p>Kiểm tra tiếp: @(Model.NextCheckAtUtc is {} check?WorkRules.LocalTime(check):"Chưa hẹn")</p><a href="/Chat?taskId=@Model.Id">Hỏi AI với công việc này</a> · <a href="/Dependencies?taskId=@Model.Id">Xem phụ thuộc</a> · <a href="/Planner">Hẹn nhắc việc</a><h3>Bước tiếp theo</h3><p class="preserve">@(Model.NextAction??"Chưa ghi bước tiếp theo.")</p><details><summary>Thông tin nguồn nhập</summary><p class="preserve">@(Model.SourceLabel??"Tạo thủ công")</p></details><form asp-action="Archive" asp-route-id="@Model.Id" method="post"><input name="version" type="hidden" value="@Model.Version"/><button>Lưu trữ công việc</button></form></section></div><partial name="_History" model="(IEnumerable<AuditEvent>)ViewBag.History"/>


