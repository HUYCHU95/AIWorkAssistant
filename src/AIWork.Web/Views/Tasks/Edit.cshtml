@model WorkTask
@{ViewData["Title"]="Thông tin công việc";}
<div class="page-heading"><h1>Thông tin công việc</h1><a href="/Tasks">← Danh sách</a></div>
<partial name="_AIEntry"/>
<form class="card editor" asp-action="Edit" asp-route-id="@Model.Id" method="post"><input type="hidden" asp-for="Id"/><input type="hidden" asp-for="Version"/><div asp-validation-summary="All" class="validation"></div><label asp-for="Title">Tên công việc *</label><input asp-for="Title" required maxlength="500"/><div class="grid"><div><label asp-for="ProjectId">Dự án (tùy chọn)</label><select asp-for="ProjectId"><option value="">Không có dự án</option>@foreach(Project p in ViewBag.Projects){<option value="@p.Id">@p.Name @(p.ArchivedAtUtc != null ? "· Đã lưu trữ" : "")</option>}</select></div><div><label asp-for="WorkstreamId">Luồng độc lập (chỉ khi không chọn dự án)</label><select asp-for="WorkstreamId"><option value="">Không có / theo dự án</option>@foreach(Workstream w in ViewBag.Workstreams){<option value="@w.Id">@w.Name @(w.ArchivedAtUtc != null ? "· Đã lưu trữ" : "")</option>}</select></div><div><label asp-for="OwnerText">Người phụ trách đã xác nhận</label><input asp-for="OwnerText" maxlength="200"/></div><div><label asp-for="Status">Trạng thái</label><select asp-for="Status" asp-items="Ui.Options<WorkStatus>()"></select></div><div><label asp-for="Priority">Ưu tiên</label><select asp-for="Priority" asp-items="Ui.Options<Priority>()"></select></div><div><label asp-for="StartDate">Ngày bắt đầu</label><input asp-for="StartDate" type="date"/></div><div><label asp-for="DueDate">Ngày hạn (có thể để trống)</label><input asp-for="DueDate" type="date"/></div><div><label asp-for="DueDateType">Loại hạn</label><select asp-for="DueDateType" asp-items="Ui.Options<DeadlineType>()"><option value="">Chưa có hạn</option></select></div></div><div class="grid"><div><label asp-for="FollowUpPersonText">Người theo dõi (khác PIC thực hiện)</label><input asp-for="FollowUpPersonText"/></div><div><label asp-for="WaitingFor">Đang chờ ai / việc gì</label><input asp-for="WaitingFor"/></div><div><label asp-for="Blocker">Điểm cản trở</label><input asp-for="Blocker"/></div><div><label asp-for="NextCheckAtUtc">Lần kiểm tra tiếp (UTC; hiển thị giờ VN ở Planner)</label><input asp-for="NextCheckAtUtc" type="datetime-local"/></div></div><label asp-for="Description">Mô tả</label><textarea asp-for="Description" rows="4"></textarea><label asp-for="NextAction">Bước tiếp theo</label><textarea asp-for="NextAction" rows="3"></textarea><label asp-for="CompletionEvidence">Bằng chứng hoàn thành (nếu có)</label><textarea asp-for="CompletionEvidence" rows="3"></textarea><p class="muted">Khi chuyển sang Hoàn thành, hệ thống ghi thời điểm UTC hiện tại. Không có bằng chứng sẽ được đánh dấu rõ.</p><button class="button">Lưu công việc</button></form>
