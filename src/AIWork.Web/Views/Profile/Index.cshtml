@model AIWork.Web.Controllers.PasswordChange
@{ViewData["Title"]="Tài khoản";}
<h1>Tài khoản cá nhân · @User.Identity?.Name</h1><form class="card auth" method="post" asp-action="ChangePassword"><div asp-validation-summary="All" class="validation"></div><label asp-for="CurrentPassword">Mật khẩu hiện tại</label><input asp-for="CurrentPassword" autocomplete="current-password" required/><label asp-for="NewPassword">Mật khẩu mới (12–128 ký tự)</label><input asp-for="NewPassword" autocomplete="new-password" required/><label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label><input asp-for="ConfirmPassword" autocomplete="new-password" required/><button class="button">Đổi mật khẩu & thu hồi phiên đăng nhập</button></form>
