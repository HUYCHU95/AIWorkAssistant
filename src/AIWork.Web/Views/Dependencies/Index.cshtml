@model List<TaskDependency>
@{ViewData["Title"]="Phụ thuộc công việc";var tasks=(List<WorkTask>)ViewBag.Tasks;}
<h1>Phụ thuộc công việc</h1><section class="card"><form method="post" asp-action="Add"><label>Công việc<select name="taskId">@foreach(var t in tasks){<option value="@t.Id">@t.Title</option>}</select></label><label>Phụ thuộc vào<select name="dependsOn">@foreach(var t in tasks){<option value="@t.Id">@t.Title</option>}</select></label><button class="button">Thêm phụ thuộc</button></form><p class="muted">Không cho phép tự phụ thuộc hoặc tạo vòng lặp.</p>@foreach(var d in Model){<div class="list-link"><span>@(tasks.FirstOrDefault(t=>t.Id==d.TaskId)?.Title) ← @(tasks.FirstOrDefault(t=>t.Id==d.DependsOnTaskId)?.Title)</span><form method="post" asp-action="Remove" asp-route-id="@d.Id"><button>Gỡ liên kết</button></form></div>}</section>
